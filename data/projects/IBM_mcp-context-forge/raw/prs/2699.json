  "metadata": {
    "title": "Enforce Default RBAC Role Assignment and Migration for Existing Users",
    "state": "closed",
    "created_at": "2026-02-04T13:53:20+00:00",
    "updated_at": "2026-02-10T17:50:25+00:00",
