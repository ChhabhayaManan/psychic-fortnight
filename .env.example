# LLM Provider Configuration
# Choose one or multiple providers

# watsonx.ai (IBM) - Recommended for IBM alignment
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Default LLM Provider
DEFAULT_LLM_PROVIDER=watsonx  # Options: watsonx, openai, anthropic, groq

# GitHub Integration
GITHUB_TOKEN=ghp_your_token_here

# Storage Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
EXTRACTED_DATA_DIR=./data/extracted
GRAPH_DATA_DIR=./data/graph
SNAPSHOTS_DIR=./data/snapshots
EMBEDDINGS_DIR=./data/embeddings
STATE_DIR=./data/state

# Autonomous Processing Configuration
AUTO_PROCESS_ON_CONNECT=true
MAX_WORKERS=3
BATCH_SIZE=10
PROCESS_RATE_LIMIT=100  # items per minute

# Discovery Settings
DISCOVER_ALL_PRS=true
DISCOVER_ALL_ISSUES=true
DISCOVER_CLOSED_ITEMS=true
MAX_ITEMS_PER_SOURCE=10000

# Monitoring
SYNC_INTERVAL=300  # seconds (5 minutes)
ENABLE_CONTINUOUS_SYNC=true

# Processing Priorities
PRIORITY_RECENT_ITEMS=true
PRIORITY_HIGH_ACTIVITY=true

# Confidence Threshold
CONFIDENCE_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=json  # Options: json, text

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=./data/embeddings
CHROMA_COLLECTION_NAME=engineering_memory

# Application
APP_NAME=Psychic Fortnight
APP_VERSION=0.1.0
DEBUG=false
